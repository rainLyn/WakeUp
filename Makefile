# ============================================================================
# WakeUp — 网络唤醒工具 Makefile
# ============================================================================
# 用法:
#   make           编译
#   make run       编译并运行
#   make clean     清理编译产物
#   make install   安装到 /usr/local/bin
# ============================================================================

BIN     := wakeup
INSTALL := /usr/local/bin

# ---- ANSI 色彩（捕获真实 ESC 字节，避免 printf 转义歧义） ----
E   := $(shell printf '\033')
B   := $(E)[1m
D   := $(E)[2m
G   := $(E)[32m
Bl  := $(E)[34m
C   := $(E)[36m
R   := $(E)[0m

# ---- 视觉符号（终端兼容） ----
ARROW := →
CHECK := ✓

# ---------------------------------------------------------------------------
# 默认目标：编译
# ---------------------------------------------------------------------------
.PHONY: build
build:
	@printf "$(Bl)$(B)▶$(R) 编译 $(C)$(B)WakeUp$(R) $(ARROW) $(C)$(B)$(BIN)$(R)\n"
	go build -o $(BIN) .
	@printf "$(G)$(B)  $(CHECK)$(R) 编译完成\n"

# ---------------------------------------------------------------------------
# 编译并运行
# ---------------------------------------------------------------------------
.PHONY: run
run: build
	@printf "$(Bl)$(B)▶$(R) 启动 $(C)$(B)$(BIN)$(R)\n\n"
	./$(BIN)

# ---------------------------------------------------------------------------
# 清理编译产物
# ---------------------------------------------------------------------------
.PHONY: clean
clean:
	@printf "$(Bl)$(B)▶$(R) 清理编译产物\n"
	@rm -f $(BIN)
	@printf "$(G)$(B)  $(CHECK)$(R) 清理完成\n"

# ---------------------------------------------------------------------------
# 安装到系统路径
# ---------------------------------------------------------------------------
.PHONY: install
install: build
	@printf "$(Bl)$(B)▶$(R) 安装 $(C)$(BIN)$(R) $(ARROW) $(D)$(INSTALL)/$(R)\n"
	sudo cp $(BIN) $(INSTALL)/$(BIN)
	@printf "$(G)$(B)  $(CHECK)$(R) 安装完成\n"
